# Copy to apps/chat-editing-video-server/.env and adjust.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,app://local

DATABASE_URL=postgres://cev:cev@localhost:5432/cev
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=bull

# Local file storage root (relative to the server package or absolute)
STORAGE_DIR=./storage

# MP4 / MOV upload policy (per batch 3, per project 10)
UPLOAD_MAX_MB=1024
MEDIA_MAX_ASSETS=10
# Native FFmpeg / FFprobe (absolute executable paths also supported)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_WORKER_ENABLED=true
MEDIA_THREADS=4
# On-demand frame image LRU cache; originals and edit videos are retained separately
MEDIA_CACHE_MB=2048

# Local LLM via Ollama's OpenAI-compatible API
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
# Local Ollama CPU mode for machines whose CUDA runner cannot initialize
LLM_OLLAMA_CPU=false
LLM_TIMEOUT_MS=180000

# Local test login (fixed code 123456; no SMS)
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_RESEND_SECONDS=60
AUTH_SESSION_TTL_SECONDS=604800
