{
  "name": "@cev/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chat Editing Video desktop app",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node -e \"require('electron')\"",
    "dev": "cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "pnpm --filter @cev/web build && electron-vite build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cev/shared": "workspace:*",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
