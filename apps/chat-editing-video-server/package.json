    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "bullmq": "^6.7.1",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "mediabunny": "1.65.2",
    "multer": "^2.5.0",
    "nestjs-pino": "^5.3.1",
    "openai": "^7.52.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
